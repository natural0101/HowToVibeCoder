<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>HowToVibeCoder</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);Installer\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="assets\fonts\Oswald-Bold.ttf;assets\fonts\Oswald-SemiBold.ttf;assets\fonts\PTSans-Regular.ttf;assets\fonts\PTSans-Bold.ttf;assets\fonts\Onest-Medium.ttf;assets\fonts\Onest-Bold.ttf;assets\fonts\Unbounded-Bold.ttf;assets\fonts\Onest-OFL.txt;assets\fonts\Unbounded-OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\models\**\*.glb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="assets\icons\**\*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="assets/sounds/*.wav;assets/sounds/vo/**/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="assets/ui/*.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Raylib-cs" Version="7.0.1" />
  </ItemGroup>
</Project>
